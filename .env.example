# 복사해서 .env 로 저장: cp .env.example .env
# 값은 .env 에만 넣는다. .env 는 .gitignore 대상이며 Slack/Notion/Drive 어디에도 올리지 않는다.

# OpenAI — 표준(프로젝트) 키. https://platform.openai.com/settings/organization/api-keys
OPENAI_API_KEY=
# OpenAI — Admin 키 (Usage/Costs API 전용, 조직 Owner만 생성). https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=

# Anthropic — 일반 키. https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Anthropic — Admin 키 (usage_report/cost_report 전용, 조직 admin만 생성)
ANTHROPIC_ADMIN_KEY=

# Google Gemini — AI Studio 키. https://aistudio.google.com/apikey
GEMINI_API_KEY=
